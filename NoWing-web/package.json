{
  "name": "novvin-web",
  "private": true,
  "version": "9.0.58",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./scripts/ensure-web-build-env.mjs",
    "build": "tsc -b && vite build && node scripts/prerender-public-home.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "vercel:install": "npm ci --legacy-peer-deps",
    "vercel:build": "npm run build",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "analyze": "vite-bundle-analyzer dist",
    "deploy:preview": "vercel --cwd ..",
    "deploy:production": "vercel --cwd .. --prod",
    "test:media": "node --test tests/media-worker.test.mjs",
    "test:seo": "node --test tests/public-home.test.mjs",
    "check:production-seo": "node scripts/check-production-seo.mjs",
    "seo:config": "node scripts/update-public-seo-policy.mjs"
  },
  "dependencies": {
