    "livekit-client": "2.22.4",
    "lucide-react": "^0.400.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.4.0",
    "react-intersection-observer": "^9.8.0",
    "react-router-dom": "^7.18.2",
