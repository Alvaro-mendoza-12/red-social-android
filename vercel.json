{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'sha256-Z5zcSVWrbyEkoySVjDGgs2Coexv24PRu7GHnVRHofFs=' 'sha256-PXyJBcCAupIWoc9JEWHlQyDk76p9Mhv23XVH5Z6JyUs=' 'sha256-6NVhZw+KPgikBQvFUBqq48bYmKUO+G6X0oXQoxxM63A=' 'sha256-rrR+ELQpxLuHY6eQckALKXVFDWBOqAa81uZgxp7EGTU=' 'sha256-Aa5fnUJyf6lbB2nGKMxDhM+XCWKMTafZgTl85Vd8Kyk=' 'sha256-MJahn92HnyYXeXs5y8y3ouh/1SrwnA+G3kV1deKK5qE=' 'sha256-P4MF/LoXS+lSIYaSGxqjjPyYijBHeIFV3qQYdzWu6hs=' 'sha256-seaggYt7ga277SlVC3KdG/xdF1Z2hanIhwo8qUpquIE=' 'sha256-YPjrBa8a7zUTBBbYzxavGYj2K8QM+hzvWM3f+aqrbwI=' 'sha256-74BDx7OOHaNpn6CZ5Geh/ymWph+UDcE00g/eOtAKE30=' 'sha256-KmvhSTriuLrw3gKxbFNGola2ZWl4PeJE3tWLGUxtfcw=' 'sha256-7rKunVQq4VCCsqyV58TyFgOAPNcprldPwmTA5Pg8HWk='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self' blob:;"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/register",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/forgot-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/explore/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/u/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/profile/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/chat/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/novvin-media-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/"
    },
    {
      "destination": "/novvin-web.html",
      "source": "/novvin-web"
    },
    {
      "destination": "/vincular-web.html",
      "source": "/ayuda/vincular-web"
    },
    {
      "source": "/mensajes",
      "destination": "/mensajes.html"
    },
    {
      "source": "/videos",
      "destination": "/videos.html"
    },
    {
      "source": "/salas-de-voz",
      "destination": "/salas-de-voz.html"
    },
    {
      "source": "/social",
      "destination": "/social.html"
    },
    {
      "source": "/momentos",
      "destination": "/momentos.html"
    },
    {
      "source": "/comunidades",
      "destination": "/comunidades.html"
    },
    {
      "source": "/juegos",
      "destination": "/juegos.html"
    },
    {
      "source": "/asistente",
      "destination": "/asistente.html"
    },
    {
      "source": "/ayuda",
      "destination": "/ayuda.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/login",
      "destination": "/app-shell.html"
    },
    {
      "source": "/register",
      "destination": "/app-shell.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/app-shell.html"
    },
    {
      "source": "/explore/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/u/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/chat/:path*",
      "destination": "/app-shell.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/novvin-web.html",
      "destination": "/novvin-web",
      "permanent": true
    },
    {
      "source": "/mensajes.html",
      "destination": "/mensajes",
      "permanent": true
    },
    {
      "source": "/videos.html",
      "destination": "/videos",
      "permanent": true
    },
    {
      "source": "/salas-de-voz.html",
      "destination": "/salas-de-voz",
      "permanent": true
    },
    {
      "source": "/vincular-web.html",
      "destination": "/ayuda/vincular-web",
      "permanent": true
    },
    {
      "source": "/social.html",
      "destination": "/social",
      "permanent": true
    },
    {
      "source": "/momentos.html",
      "destination": "/momentos",
      "permanent": true
    },
    {
      "source": "/comunidades.html",
      "destination": "/comunidades",
      "permanent": true
    },
    {
      "source": "/juegos.html",
      "destination": "/juegos",
      "permanent": true
    },
    {
      "source": "/asistente.html",
      "destination": "/asistente",
      "permanent": true
    },
    {
      "source": "/ayuda.html",
      "destination": "/ayuda",
      "permanent": true
    }
  ]
}
