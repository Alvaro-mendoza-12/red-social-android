PORT=3001

# Ubuntu API used to validate accounts and enforce room permissions.
FALLBACK_API_URL=https://api.example.com

# Supabase admin access for signaling server features and bearer-token validation.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated HTTPS origins allowed to use the signaling HTTP/socket endpoints.
# Native mobile clients usually connect without Origin header, so they remain allowed.
SIGNALING_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Basic abuse controls for public endpoints and socket handshakes.
HTTP_RATE_LIMIT_PER_MINUTE=180
SOCKET_RATE_LIMIT_PER_MINUTE=90
SOCKET_EVENT_RATE_LIMIT_PER_MINUTE=900

# Optional resolver token already used by the project.
RD_TOKEN=

# Self-hosted coturn REST credentials endpoint.
# TURN_HOST should be the public DNS name that points to your VPS.
TURN_HOST=voice.srv1495648.hstgr.cloud
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=replace-with-a-long-random-secret
TURN_REALM=voice.srv1495648.hstgr.cloud
TURN_TTL_SECONDS=3600
TURN_ENABLE_UDP=true
TURN_ENABLE_TCP=true
TURN_ENABLE_TLS=false
