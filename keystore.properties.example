# Android release signing (do NOT commit real secrets)
#
# Create a local copy named `keystore.properties` (it is ignored by git) and fill in:
#
# storeFile=path/to/your-upload-key.jks
# storePassword=YOUR_STORE_PASSWORD
# keyAlias=YOUR_KEY_ALIAS
# keyPassword=YOUR_KEY_PASSWORD
#
# Tip: You can use an absolute path (Windows example):
# storeFile=C:\\Users\\you\\keys\\upload-key.jks
#
# You can also use a path relative to the repo root, for example:
# storeFile=keys\\upload-key.jks
#
# Workflow:
# 1. Copy this file to `keystore.properties`
# 2. Fill the real values locally
# 3. Do not commit `keystore.properties` or the `.jks`
storeFile=
storePassword=
keyAlias=
keyPassword=
