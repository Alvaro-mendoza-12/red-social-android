POSTGRES_PASSWORD=change-this-local-postgres-password
# Runtime API: configurar URL privada de novvin_api después del bootstrap de db/operations.
# No usar POSTGRES_PASSWORD ni el superusuario de bootstrap como credencial de API.
FALLBACK_API_DATABASE_URL=
FALLBACK_API_PORT=3001
# Para ejecutar Node directamente en la laptop, API_LISTEN_HOST=127.0.0.1.
FALLBACK_EDGE_PORT=3080
FALLBACK_REALTIME_PORT=3002
FALLBACK_DB_PORT=5433
# Pool de PostgreSQL para la API. Aumentar DATABASE_POOL_MAX solo después de
# medir la base de datos y considerando todas las réplicas de la API.
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# Tiempo máximo por sentencia durante las migraciones aditivas de arranque.
SCHEMA_INITIALIZATION_TIMEOUT_MS=180000
# Login, recuperación y uploads usan PostgreSQL como contador compartido entre réplicas.
PUBLIC_BASE_URL=
# Producción requiere un dominio HTTPS estable. Los Quick Tunnels y los
# dominios efímeros de ngrok sólo se permiten si se declara explícitamente
# durante una prueba controlada; no son una ruta de lanzamiento.
ALLOW_EPHEMERAL_PUBLIC_ORIGIN=false
# Descubrimiento rotatorio firmado. La clave privada se genera fuera del repo,
# chmod 600, y sólo existe en el servidor. El TXT nunca publica una URL plana.
DUCKDNS_DOMAIN=conectate-alvaro.duckdns.org
DUCKDNS_TOKEN=
BACKEND_DISCOVERY_PRIVATE_KEY_FILE=/home/alvaro/.config/novvin/backend-discovery-private.pem
BACKEND_DISCOVERY_TTL_SECONDS=86400
# En Ubuntu (deploy): ../signaling-server desde esta carpeta. En el repo Windows: ../../signaling-server
SIGNALING_CONTEXT=../signaling-server
JWT_SECRET=change-this-with-openssl-rand-hex-32
# Mantén esta clave fija: cifra los secretos TOTP. No la cambies al rotar JWT_SECRET.
TOTP_ENCRYPTION_KEY=change-this-with-a-different-openssl-rand-hex-32
STORAGE_SIGNING_SECRET=change-this-with-a-different-openssl-rand-hex-32
STORAGE_ACCEL_PREFIX=/_novvin_storage
REALTIME_INTERNAL_SECRET=change-this-with-openssl-rand-hex-32
LIVE_INTERNAL_EVENTS_TOKEN=change-this-with-another-openssl-rand-hex-32
OPENVERSE_API_TOKEN=
OPENVERSE_API_BASE=https://api.openverse.org/v1/audio/
JAMENDO_CLIENT_ID=
JWT_ISSUER=conectate-local-fallback
JWT_EXPIRES_IN=7d
# Web: bearer corto sólo en memoria + sesión opaca HttpOnly. No subir el bearer
# web por encima de 30 minutos sin una revisión formal de riesgo.
WEB_JWT_EXPIRES_IN=15m
WEB_SESSION_TTL_DAYS=30
WEB_SESSION_RATE_LIMIT_PER_15_MINUTES=120
CORS_ORIGIN=https://novvinapp.com,https://www.novvinapp.com,https://red-social-android.vercel.app
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=10
AUTH_LOGIN_RATE_LIMIT_PER_15_MINUTES=20
AUTH_PASSWORD_RESET_RATE_LIMIT_PER_15_MINUTES=5
AUTH_SENSITIVE_RATE_LIMIT_PER_15_MINUTES=12
AUTH_PAIRING_RATE_LIMIT_PER_MINUTE=90
STORAGE_UPLOAD_RATE_LIMIT_PER_10_MINUTES=120
SIGNALING_ALLOWED_ORIGINS=https://novvinapp.com,https://www.novvinapp.com,https://red-social-android.vercel.app
HTTP_RATE_LIMIT_PER_MINUTE=180
SOCKET_RATE_LIMIT_PER_MINUTE=90
SOCKET_EVENT_RATE_LIMIT_PER_MINUTE=900
# Redis Streams privado para difusión entre réplicas y recuperación de sesiones Socket.IO.
# scripts/deploy-stack-safely.sh crea el archivo con permisos 600 si no existe.
SIGNALING_REDIS_PASSWORD_FILE=./secrets/signaling-redis-password.txt
SIGNALING_REDIS_STREAM_COUNT=4
SIGNALING_REDIS_MAX_MEMORY=256mb
SIGNALING_CONNECTION_RECOVERY_MS=120000
# Se mantiene apagado hasta que las pruebas multi-proceso demuestren la
# rehidratación completa del estado avanzado de Live después de perder un nodo.
SIGNALING_CONNECTION_RECOVERY_ENABLED=false
SIGNALING_REDIS_MAX_RECONNECT_ATTEMPTS=12
# Estado recuperable de Live en Redis. El lease corto detecta procesos caídos;
# la instantánea nunca incluye bearer tokens ni identificadores de socket.
SIGNALING_LIVE_STATE_TTL_SECONDS=86400
SIGNALING_LIVE_HOST_LEASE_SECONDS=45
# Mantén 1 hasta completar las pruebas de carga multi-réplica del estado avanzado de Live.
SIGNALING_REPLICAS=1
SIGNALING_MULTI_REPLICA_APPROVED=false
# TURN/Coturn autoalojado (configúralo con scripts/configure-mini-pc-turn.sh)
# Bajo CGNAT, Cloudflare Tunnel sólo expone API/signaling HTTP+WebSocket:
# el audio/video/screen share necesita TURN público aparte (VPS/servicio TURN).
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=
TURN_REALM=
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_TTL_SECONDS=3600
TURN_ENABLE_UDP=true
TURN_ENABLE_TCP=true
TURN_ENABLE_TLS=false
# Alternativa para CGNAT puro o mientras no haya VPS/puertos públicos:
# STUN_STATIC_URLS=stun:turn.example.com:3478
# TURN_STATIC_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_STATIC_USERNAME=
# TURN_STATIC_CREDENTIAL=
# Producción falla de forma segura si se intenta usar console/response, porque
# expondrían tokens de recuperación en logs o respuestas HTTP.
PASSWORD_RESET_DELIVERY=disabled
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Para habilitar recuperación real por correo: PASSWORD_RESET_DELIVERY=smtp
# Configura estos valores solo en .env privado, nunca en Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
LEGACY_SUPABASE_IMPORT_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKETS=
SUPABASE_STORAGE_DRY_RUN=false
SUPABASE_STORAGE_OVERWRITE=false
SUPABASE_STORAGE_PAGE_SIZE=100
SUPABASE_STORAGE_SOURCE_BASE_URLS=
SUPABASE_STORAGE_REWRITE_APPLY=false
ADMIN_SYNC_TOKEN=change-this-with-openssl-rand-hex-32
# Use immutable local/supabase UUIDs. Email-based admin access is disabled by default
# because local registration does not prove ownership of an address.
ADMIN_USER_IDS=
ALLOW_LEGACY_ADMIN_EMAIL_ADMINS=false
ADMIN_EMAILS=

# Monedas para regalos en Android. Mantener desactivado hasta configurar los
# productos consumibles en Play Console y la cuenta de servicio Android Publisher.
LIVE_COIN_PURCHASES_ENABLED=false
LIVE_GIFTS_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=conectate.com
GOOGLE_PLAY_COIN_PACKAGES_JSON={"novvin_coins_70":70,"novvin_coins_140":140,"novvin_coins_350":350,"novvin_coins_700":700,"novvin_coins_1400":1400,"novvin_coins_3500":3500,"novvin_coins_7000":7000,"novvin_coins_14000":14000}
LIVE_GIFT_MAX_COINS_PER_GIFT=5000
LIVE_GIFT_MAX_COINS_PER_DAY=25000
LIVE_GIFT_MAX_GIFTS_PER_MINUTE=20
LIVE_GIFT_HIGH_VALUE_CONFIRMATION_COINS=900
# Directorio de secretos en el host; el JSON nunca se incluye en la app ni en Git.
GOOGLE_PLAY_SERVICE_ACCOUNT_DIR=./secrets
# Ruta dentro del contenedor api; se monta como solo lectura.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/novvin-secrets/google-play-service-account.json
# Compatibilidad heredada: no rellenar si se usa GOOGLE_PLAY_SERVICE_ACCOUNT_FILE.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_REFUND_RECONCILIATION_ENABLED=true
GOOGLE_PLAY_REFUND_RECONCILIATION_INTERVAL_MINUTES=5
GOOGLE_PLAY_REFUND_RECONCILIATION_LOOKBACK_HOURS=720
# Google Play RTDN: el audience debe ser exactamente el endpoint HTTPS público.
# Pub/Sub firma cada push con OIDC; esta cuenta es la identidad autorizada a invocarlo.
GOOGLE_PLAY_RTDN_ENABLED=false
GOOGLE_PLAY_RTDN_AUDIENCE=https://api.example.com/webhooks/google-play/rtdn
GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=novvin-rtdn-push@example-project.iam.gserviceaccount.com
# Defensa adicional opcional en la URL de la suscripción. OIDC ya autentica
# audiencia, emisor y cuenta; dejar vacío evita secretos en URL y registros.
GOOGLE_PLAY_RTDN_VERIFICATION_TOKEN=
# NEUTRAL aporta evidencia de consumo sin decidir automáticamente el contracargo.
GOOGLE_PLAY_PENDING_REFUND_PREFERENCE=NEUTRAL

# Retiros de creadores. Permanecen cerrados hasta completar PayPal Sandbox,
# registrar el webhook firmado y revisar la tasa comercial por moneda.
CREATOR_PAYOUTS_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
CREATOR_PAYOUT_MINOR_PER_COIN=0
CREATOR_PAYOUT_MINIMUM_MINOR=0
CREATOR_EARNINGS_HOLD_DAYS=7
CREATOR_PAYOUT_CURRENCY=USD

# LiveKit SFU para invitados, batallas y salas colaborativas.
# Mantener apagado hasta verificar el backend. Estas claves viven solo en el
# servidor (nunca en Android, el APK ni el repositorio).
LIVE_GUESTS_BATTLES_ENABLED=false
LIVE_SFU_ENABLED=false
LIVE_MAX_GUESTS=4
# Avisos a seguidores al iniciar un directo. Activar solo tras validar FCM y
# las preferencias de notificación en pruebas cerradas.
LIVE_FOLLOWER_NOTIFICATIONS_ENABLED=false
# Juego ligero de dibujo/adivinanza. Mantener apagado hasta aplicar la
# migración 007 y completar pruebas E2E Android/API/PostgreSQL.
LIVE_DRAW_GUESS_ENABLED=false

# Puntos gratuitos por tiempo visible dentro de un directo. Son independientes
# de monedas y nunca generan saldo retirable. El secreto firma sesiones cortas
# y debe existir únicamente en el backend (32+ bytes aleatorios).
LIVE_CHANNEL_POINTS_ENABLED=false
LIVE_POINTS_SESSION_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Mi algoritmo es una capacidad autenticada disponible para cada usuario; no
# depende de feature flags. Nunca usa mensajes privados, ubicación precisa,
# edad ni género. El backfill sí conserva su compuerta de mantenimiento.
# Backfill is a separate, explicit maintenance gate. It remains disabled even
# when the online classifier is enabled.
USER_ALGORITHM_CLASSIFICATION_BACKFILL_ENABLED=false
USER_ALGORITHM_CLASSIFICATION_BACKFILL_LIMIT=2000
# Secreto sólo de backend para cursores de recomendaciones. Configúralo fuera
# del repositorio; no reutilizar ni registrar este valor en Android.
ALGORITHM_RECOMMENDATION_CURSOR_SECRET=
SOCIAL_DISCOVERY_ENABLED=false
SOCIAL_ROOMS_ENABLED=false

# Estadísticas privadas del creador: autenticadas y verificadas por ownership.
# El secreto HMAC vive solo en el backend y debe tener 32+ bytes.
CREATOR_ANALYTICS_MIN_COHORT=10
CREATOR_ANALYTICS_HASH_SECRET=

# Socializar: base de consentimiento explícito. Estas banderas son separadas
# del algoritmo y nacen apagadas; activar una no crea coincidencias, salas ni
# chat aleatorio. No usar mensajes privados, ubicación precisa ni atributos
# sensibles como señal de descubrimiento.
SOCIALIZATION_ENABLED=false
SOCIALIZATION_CARDS_ENABLED=false
SOCIALIZATION_DISCOVERY_ENABLED=false
SOCIALIZATION_CONNECTION_REQUESTS_ENABLED=false
SOCIALIZATION_COMMUNITY_DISCOVERY_ENABLED=false
SOCIALIZATION_ICEBREAKERS_ENABLED=false
SOCIALIZATION_ROOMS_ENABLED=false

# PlayMatch / Juegos. El modulo permanece cerrado por defecto. Para una prueba
# limitada, use PLAYMATCH_TESTER_IDS con IDs de usuario separados por coma y un
# secreto de cursor generado fuera del repositorio. Nunca use ubicación precisa,
# mensajes privados, edad o género como señales de coincidencia.
PLAYMATCH_GAMES_ENABLED=true
PLAYMATCH_TESTER_IDS=
PLAYMATCH_TESTER_EMAILS=
PLAYMATCH_CURSOR_SECRET=
PLAYMATCH_REQUIRE_ADULT_CONFIRMATION=true
PLAYMATCH_PHOTOS_ENABLED=true
PLAYMATCH_CATALOG_ADMIN_SYNC_ENABLED=false
PLAYMATCH_CATALOG_PROVIDER=wikidata
PLAYMATCH_CATALOG_MIN_RELEASE_YEAR=2000
PLAYMATCH_CATALOG_USER_AGENT=NovvinPlayMatch/1.0 (catalog-sync; support@conectate.com)
PLAYMATCH_STEAM_STORE_ASSETS_APPROVED=false
# RAWG actualmente requiere un plan comercial para Novvin. Mantener en false
# hasta obtener y documentar autorizacion comercial; la clave vive solo en el servidor.
PLAYMATCH_RAWG_COMMERCIAL_USE_APPROVED=false
RAWG_API_KEY=

# IA local Novvin: perfil equilibrado para la mini PC de 4C/8T y 16 GB.
# 5000 es solo una opcion de laboratorio; no mejora por si sola la conversacion
# y hace el primer entrenamiento casi 10 veces mas costoso que 512.
AI_HIDDEN_SIZE=512
AI_TRAIN_EPOCHS=100
AI_LEARNING_RATE=0.06
AI_CONFIDENCE_THRESHOLD=0.34
AI_REQUEST_TIMEOUT_MS=3000
AI_CHAT_REQUEST_TIMEOUT_MS=3000
AI_CHAT_RATE_LIMIT_PER_MINUTE=30
AI_FEEDBACK_RATE_LIMIT_PER_MINUTE=20
AI_FEEDBACK_MAX_BYTES=16777216
AI_CPU_LIMIT=0.75
AI_MEMORY_LIMIT=512m
AI_NODE_HEAP_MB=320
# AI_DATA_ROOT=./ai-chatbot-data

# Motor general propio: se entrena solo con data/knowledge.json, sin modelos
# descargados, proveedores generativos ni conexiones de red.
AI_KNOWLEDGE_ENABLED=true
AI_KNOWLEDGE_THRESHOLD=0.34
AI_KNOWLEDGE_HIDDEN_SIZE=96
AI_KNOWLEDGE_EPOCHS=140
AI_KNOWLEDGE_LEARNING_RATE=0.055

# Música comunitaria. En producción el escaneo es obligatorio. Mantenga las
# firmas de ClamAV actualizadas mediante el job/volumen de infraestructura;
# Android nunca recibe ni ejecuta este comando.
MUSIC_ANTIVIRUS_REQUIRED=true
MUSIC_ANTIVIRUS_COMMAND=clamscan
MUSIC_ANTIVIRUS_TIMEOUT_MS=90000
