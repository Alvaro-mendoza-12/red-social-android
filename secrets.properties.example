# Copy this file to `secrets.properties` and fill the values (do NOT commit secrets.properties)
#
# Backend Ubuntu (mini PC / servidor propio). Supabase debe quedar vacío en builds de producción.
FALLBACK_API_URL=https://conectate-alvaro.duckdns.org
BACKEND_DISCOVERY_HOST=conectate-alvaro.duckdns.org
BACKEND_CONFIG_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
TMDB_API_KEY=
REAL_DEBRID_TOKEN=
# Optional providers only. If you deploy coturn on your VPS and expose /turn-credentials
# from signaling-server, you can leave these empty in production builds.
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=red-social
OPENRELAY_TURN_URL=
OPENRELAY_USERNAME=
OPENRELAY_PASSWORD=
