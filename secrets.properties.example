# Copy this file to `secrets.properties` and fill the values (do NOT commit secrets.properties)
#
# Backend Ubuntu (mini PC / servidor propio). Supabase debe quedar vacío en builds de producción.
# Public Funnel origin on standard HTTPS port 443. It must answer /ready and
# expose /v1, /rest, /storage and /socket.io before building an APK.
FALLBACK_API_URL=https://conectate.tail9b267c.ts.net
SIGNALING_URL=https://conectate.tail9b267c.ts.net
BACKEND_DISCOVERY_HOST=conectate-alvaro.duckdns.org
BACKEND_CONFIG_URL=
# Clave pública ECDSA P-256 (SPKI DER en Base64). No es secreta. Si queda vacía,
# Android usa config/backend-discovery-public-key.txt. Es obligatoria cuando
# FALLBACK_API_URL usa trycloudflare/ngrok.
BACKEND_DISCOVERY_PUBLIC_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional providers only. If you deploy coturn on your VPS and expose /turn-credentials
# from signaling-server, you can leave these empty in production builds.
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=red-social
OPENRELAY_TURN_URL=
OPENRELAY_USERNAME=
OPENRELAY_PASSWORD=
