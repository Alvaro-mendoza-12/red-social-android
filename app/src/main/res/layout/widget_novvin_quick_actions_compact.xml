<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_novvin_background" android:padding="6dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginEnd="6dp" android:contentDescription="@string/app_name" android:src="@mipmap/ic_launcher" />
    <ImageView android:id="@+id/widget_messages" android:layout_width="0dp" android:layout_height="48dp"
        android:minWidth="48dp" android:layout_weight="1" android:layout_marginStart="4dp"
        android:background="@drawable/widget_novvin_action" android:src="@drawable/widget_icon_messages"
        android:padding="12dp" android:contentDescription="@string/widget_chat_title" />
    <ImageView android:id="@+id/widget_videos" android:layout_width="0dp" android:layout_height="48dp"
        android:minWidth="48dp" android:layout_weight="1" android:layout_marginStart="4dp"
        android:background="@drawable/widget_novvin_action" android:src="@drawable/widget_icon_videos"
        android:padding="12dp" android:contentDescription="@string/widget_action_videos" />
    <ImageView android:id="@+id/widget_moments" android:layout_width="0dp" android:layout_height="48dp"
        android:minWidth="48dp" android:layout_weight="1" android:layout_marginStart="4dp"
        android:background="@drawable/widget_novvin_action" android:src="@drawable/widget_icon_moment"
        android:padding="12dp" android:contentDescription="@string/widget_moments_title" />
</LinearLayout>
