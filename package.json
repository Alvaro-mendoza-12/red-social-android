{
  "name": "conectate-deploy-bridge",
  "private": true,
  "version": "2026.05.07",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "repo:hygiene": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/repo_hygiene_check.ps1",
    "repo:hygiene:strict": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/repo_hygiene_check.ps1 -Strict",
    "quality:android": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/quality_gate.ps1 -DebugOnly",
    "quality:full": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/quality_gate.ps1",
    "dev:web": "npm --prefix Conectate-web run dev",
    "lint:web": "npm --prefix Conectate-web run lint",
    "build:web": "npm --prefix Conectate-web run build",
    "preview:web": "npm --prefix Conectate-web run preview",
    "vercel:install": "npm --prefix Conectate-web ci",
    "vercel:build": "npm --prefix Conectate-web run build"
  }
}
